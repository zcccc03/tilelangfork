#include <tl_templates/ascend/common.h>

constexpr int kBatch = 28;
constexpr int kDim = 512;
constexpr int kBlocks = 28;
static_assert(kBatch > 0 && kDim > 0 && kDim % 256 == 0);
constexpr int kTilesPerAxis = kDim / 256;
constexpr int kTilesPerBatch = kTilesPerAxis * kTilesPerAxis;
constexpr int kTiles = kBatch * kTilesPerBatch;
constexpr int kWaves = (kTiles + kBlocks - 1) / kBlocks;
constexpr int kKTiles = kDim / 256;

// W is stored as [batch, N, K]. All local pointer arithmetic below is in elements.
extern "C" __global__ __cube__ void main_kernel(__gm__ float *C, __gm__ half *W, __gm__ half *X) {
  asc_init();
  auto *l1 = (__cbuf__ half *)0;
  auto *l0a = (__ca__ half *)0;
  auto *l0b = (__cb__ half *)0;
  auto *c0 = (__cc__ float *)0;
  auto *c1 = c0 + 128 * 256;

  asc_sync_notify(PIPE_MTE1, PIPE_MTE2, static_cast<event_t>(0));
  asc_sync_notify(PIPE_MTE1, PIPE_MTE2, static_cast<event_t>(1));
  for (int wave = 0; wave < kWaves; ++wave) {
    const int tile = wave * kBlocks + (int)block_idx;
    if (tile >= kTiles) break;
    const int64_t batch_base = static_cast<int64_t>(tile / kTilesPerBatch) * kDim * kDim;
    const int m_base = (tile % kTilesPerAxis) * 256;
    const int n_base = ((tile / kTilesPerAxis) % kTilesPerAxis) * 256;

    for (int kt = 0; kt < kKTiles; ++kt) {
      const int l1_slot = kt & 1;
      auto *a1 = l1 + l1_slot * 65536;
      auto *b1 = l1 + 131072 + l1_slot * 65536;
      const auto l1_event = static_cast<event_t>(l1_slot);
      asc_sync_wait(PIPE_MTE1, PIPE_MTE2, l1_event);
      asc_set_gm2l1_nz_para(1, 1, 256, 0);
      asc_copy_gm2l1_nd2nz(b1, W + batch_base + n_base * kDim + kt * 256, kDim * sizeof(half),
                           static_cast<asc_load_l2_cache_mode>(0), 256, 256, 0, 0);
      asc_set_gm2l1_nz_para(1, 1, 256, 0);
      asc_copy_gm2l1_nd2nz(a1, X + batch_base + m_base * kDim + kt * 256, kDim * sizeof(half),
                           static_cast<asc_load_l2_cache_mode>(0), 256, 256, 0, 0);
      asc_sync_notify(PIPE_MTE2, PIPE_MTE1, l1_event);
      asc_sync_wait(PIPE_MTE2, PIPE_MTE1, l1_event);

      for (int sk = 0; sk < 4; ++sk) {
        const int slot = sk & 1;
        auto *a_top = l0a + slot * 16384;
        auto *a_bottom = a_top + 8192;
        auto *b = l0b + slot * 16384;
        asc_lock(PIPE_MTE1, slot, ASC_LOCK_BLOCK);
        // Pack the two M slices independently in NZ. L1 spans 16 M fractals.
        asc_copy_l12l0a(a_top, a1, 0, sk * 4, 8, 4, 16, 8);
        asc_copy_l12l0a(a_bottom, a1, 8, sk * 4, 8, 4, 16, 8);
        asc_copy_l12l0b(b, b1, 0, sk * 4, 16, 4, 16, 16);
        asc_unlock(PIPE_MTE1, slot, ASC_LOCK_BLOCK);
        asc_lock(PIPE_M, slot, ASC_LOCK_BLOCK);
        const bool first = kt == 0 && sk == 0;
        const uint32_t flag = kt == kKTiles - 1 && sk == 3 ? 3 : 2;
        asc_mmad(c0, a_top, b, 128, 64, 256, flag, true, false, first);
        asc_mmad(c1, a_bottom, b, 128, 64, 256, flag, true, false, first);
        asc_unlock(PIPE_M, slot, ASC_LOCK_BLOCK);
      }
      asc_sync_notify(PIPE_MTE1, PIPE_MTE2, l1_event);
    }

    auto *out = C + batch_base + m_base * kDim + n_base;
    asc_set_l0c_copy_nz_para(1, 0, 0);
    asc_copy_l0c2gm(out, c0, 256, 128, kDim, 128,
                    static_cast<asc_store_l2_cache_mode>(0), static_cast<asc_unit_flag_mode>(3),
                    static_cast<asc_quant_mode>(0), static_cast<asc_relu_pre_mode>(0), 0, 1, 0, 0);
    asc_set_l0c_copy_nz_para(1, 0, 0);
    asc_copy_l0c2gm(out + 128 * kDim, c1, 256, 128, kDim, 128,
                    static_cast<asc_store_l2_cache_mode>(0), static_cast<asc_unit_flag_mode>(3),
                    static_cast<asc_quant_mode>(0), static_cast<asc_relu_pre_mode>(0), 0, 1, 0, 0);
  }
  asc_sync_wait(PIPE_MTE1, PIPE_MTE2, static_cast<event_t>(0));
  asc_sync_wait(PIPE_MTE1, PIPE_MTE2, static_cast<event_t>(1));
}
